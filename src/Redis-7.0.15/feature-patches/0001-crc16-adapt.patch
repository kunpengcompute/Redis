+	.byte	15, 14, 13, 12, 11, 10, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16
+	.byte	15, 14, 13, 12, 11, 10,  9, 16, 16, 16, 16, 16, 16, 16, 16, 16
+	.byte	15, 14, 13, 12, 11, 10,  9,  8, 16, 16, 16, 16, 16, 16, 16, 16
