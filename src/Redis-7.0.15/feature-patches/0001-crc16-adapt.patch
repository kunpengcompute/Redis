diff --git a/src/Makefile b/src/Makefile
index b0a2ac1..728f04f 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -321,9 +321,33 @@ REDIS_CLI_NAME=redis-cli$(PROG_SUFFIX)
 REDIS_CLI_OBJ=anet.o adlist.o dict.o redis-cli.o zmalloc.o release.o ae.o redisassert.o crcspeed.o crc64.o siphash.o crc16.o monotonic.o cli_common.o mt19937-64.o
 REDIS_BENCHMARK_NAME=redis-benchmark$(PROG_SUFFIX)
 REDIS_BENCHMARK_OBJ=ae.o anet.o redis-benchmark.o adlist.o dict.o zmalloc.o redisassert.o release.o crcspeed.o crc64.o siphash.o crc16.o monotonic.o cli_common.o mt19937-64.o
+# CRC16/XMODEM kernels for ARM64.
+CRC16_PMULL?=yes
+CRC16_SHA3?=yes
+CRC16_SVE?=yes
+CRC16_XMODEM_ASM_OBJ=crc16_xmodem_pmull.o crc16_xmodem_pmull_8way.o crc16_xmodem_short.o
+ifeq ($(uname_S),Linux)
+ifeq ($(uname_M),aarch64)
+ifeq ($(CRC16_PMULL),yes)
+FINAL_CFLAGS+=-DREDIS_CRC16_PMULL
+ifeq ($(CRC16_SHA3),yes)
+FINAL_CFLAGS+=-DREDIS_CRC16_SHA3
+CRC16_ASM_FLAGS+=-DCRC16_USE_SHA3
+endif
+ifeq ($(CRC16_SVE),yes)
+FINAL_CFLAGS+=-DREDIS_CRC16_SVE
+crc16_xmodem_pmull_8way.o: CRC16_ASM_FLAGS+=-DCRC16_USE_SVE
+endif
+CRC16_XMODEM_OBJ=crc16_xmodem_dispatch.o $(CRC16_XMODEM_ASM_OBJ)
+REDIS_SERVER_OBJ+=$(CRC16_XMODEM_OBJ)
+REDIS_CLI_OBJ+=$(CRC16_XMODEM_OBJ)
+REDIS_BENCHMARK_OBJ+=$(CRC16_XMODEM_OBJ)
+endif
+endif
+endif
 REDIS_CHECK_RDB_NAME=redis-check-rdb$(PROG_SUFFIX)
 REDIS_CHECK_AOF_NAME=redis-check-aof$(PROG_SUFFIX)
-ALL_SOURCES=$(sort $(patsubst %.o,%.c,$(REDIS_SERVER_OBJ) $(REDIS_CLI_OBJ) $(REDIS_BENCHMARK_OBJ)))
+ALL_SOURCES=$(filter-out $(CRC16_XMODEM_ASM_OBJ:.o=.c),$(sort $(patsubst %.o,%.c,$(REDIS_SERVER_OBJ) $(REDIS_CLI_OBJ) $(REDIS_BENCHMARK_OBJ))))
 
 all: $(REDIS_SERVER_NAME) $(REDIS_SENTINEL_NAME) $(REDIS_CLI_NAME) $(REDIS_BENCHMARK_NAME) $(REDIS_CHECK_RDB_NAME) $(REDIS_CHECK_AOF_NAME)
 	@echo ""
@@ -402,6 +426,9 @@ DEP = $(REDIS_SERVER_OBJ:%.o=%.d) $(REDIS_CLI_OBJ:%.o=%.d) $(REDIS_BENCHMARK_OBJ
 %.o: %.c .make-prerequisites
 	$(REDIS_CC) -MMD -o $@ -c $<
 
+$(CRC16_XMODEM_ASM_OBJ): %.o: %.S .make-prerequisites
+	$(REDIS_CC) $(CRC16_ASM_FLAGS) -MMD -o $@ -c $<
+
 # The file commands.c is checked in and doesn't normally need to be rebuilt. It
 # is built only if python is available and its prereqs are modified.
 ifneq (,$(PYTHON))
@@ -410,7 +437,7 @@ commands.c: commands/*.json ../utils/generate-command-code.py
 endif
 
 clean:
-	rm -rf $(REDIS_SERVER_NAME) $(REDIS_SENTINEL_NAME) $(REDIS_CLI_NAME) $(REDIS_BENCHMARK_NAME) $(REDIS_CHECK_RDB_NAME) $(REDIS_CHECK_AOF_NAME) *.o *.gcda *.gcno *.gcov redis.info lcov-html Makefile.dep
+	rm -rf $(REDIS_SERVER_NAME) $(REDIS_SENTINEL_NAME) $(REDIS_CLI_NAME) $(REDIS_BENCHMARK_NAME) $(REDIS_CHECK_RDB_NAME) $(REDIS_CHECK_AOF_NAME) *.o *.gcda *.gcno *.gcov redis.info lcov-html Makefile.dep crc16-test
 	rm -f $(DEP)
 
 .PHONY: clean
@@ -423,6 +450,16 @@ distclean: clean
 
 .PHONY: distclean
 
+# 独立校验 CRC16 的标量和当前硬件支持的汇编路径。
+# Linux ARM64 可用 CRC16_SHA3=no CRC16_SVE=no 分别验证回退构建。
+crc16-test: crc16.c .make-prerequisites $(CRC16_XMODEM_OBJ)
+	$(REDIS_CC) -DCRC16_TEST_MAIN -o $@ crc16.c $(CRC16_XMODEM_OBJ) $(FINAL_LDFLAGS)
+
+test-crc16: crc16-test
+	./crc16-test
+
+.PHONY: test-crc16
+
 test: $(REDIS_SERVER_NAME) $(REDIS_CHECK_AOF_NAME) $(REDIS_CLI_NAME) $(REDIS_BENCHMARK_NAME)
 	@(cd ..; ./runtest)
 
diff --git a/src/crc16.c b/src/crc16.c
index 7b8c1da..0e0e7ca 100644
--- a/src/crc16.c
+++ b/src/crc16.c
@@ -1,4 +1,33 @@
-#include "server.h"
+#ifdef CRC16_TEST_MAIN
+#define _GNU_SOURCE
+#endif
+#include <stdint.h>
+
+#if defined(REDIS_CRC16_PMULL) && defined(__linux__) && defined(__aarch64__) && \
+    defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#include <sys/auxv.h>
+#include <asm/hwcap.h>
+extern uint16_t crc16_xmodem(uint16_t, const uint8_t *, uint64_t);
+static int crc16_has_optimized;
+#ifdef REDIS_CRC16_SVE
+int crc16_use_sve_wide;
+#endif
+__attribute__((constructor)) static void crc16InitOptimized(void) {
+    unsigned long hw = getauxval(AT_HWCAP);
+    unsigned long required = HWCAP_PMULL;
+#ifdef REDIS_CRC16_SHA3
+    required |= HWCAP_SHA3;
+#endif
+    int available = (hw & required) == required;
+#ifdef REDIS_CRC16_SVE
+    unsigned long hw2 = getauxval(AT_HWCAP2);
+    crc16_use_sve_wide = available && (hw & HWCAP_SVE) &&
+        (hw2 & (HWCAP2_SVE2 | HWCAP2_SVEPMULL)) == (HWCAP2_SVE2 | HWCAP2_SVEPMULL);
+#endif
+    crc16_has_optimized = available;
+}
+#define CRC16_USE_OPTIMIZED
+#endif
 
 /*
  * Copyright 2001-2010 Georges Menie (www.menie.org)
@@ -79,10 +108,154 @@ static const uint16_t crc16tab[256]= {
     0x6e17,0x7e36,0x4e55,0x5e74,0x2e93,0x3eb2,0x0ed1,0x1ef0
 };
 
+#ifdef CRC16_USE_OPTIMIZED
+uint16_t crc16_xmodem_scalar(uint16_t crc, const uint8_t *buf, uint64_t len) {
+#else
+static uint16_t crc16_xmodem_scalar(uint16_t crc, const uint8_t *buf, uint64_t len) {
+#endif
+    for (uint64_t i = 0; i < len; i++)
+        crc = (uint16_t)((crc << 8) ^ crc16tab[((crc >> 8) ^ buf[i]) & 0xff]);
+    return crc;
+}
+
 uint16_t crc16(const char *buf, int len) {
-    int counter;
-    uint16_t crc = 0;
-    for (counter = 0; counter < len; counter++)
-            crc = (crc<<8) ^ crc16tab[((crc>>8) ^ *buf++)&0x00FF];
+    if (len <= 0) return 0;
+#ifdef CRC16_USE_OPTIMIZED
+    if (crc16_has_optimized)
+        return crc16_xmodem(0, (const uint8_t *)buf, (uint64_t)len);
+#endif
+    return crc16_xmodem_scalar(0, (const uint8_t *)buf, (uint64_t)len);
+}
+
+#ifdef CRC16_TEST_MAIN
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef __linux__
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+/* 独立的逐位参考算法，避免测试和生产路径共享查表错误。 */
+static uint16_t crc16Reference(uint16_t crc, const uint8_t *buf, size_t len) {
+    for (size_t i = 0; i < len; i++) {
+        crc ^= (uint16_t)buf[i] << 8;
+        for (int bit = 0; bit < 8; bit++)
+            crc = (uint16_t)((crc << 1) ^ ((crc & 0x8000) ? 0x1021 : 0));
+    }
     return crc;
 }
+
+static void crc16Check(const char *path, uint16_t actual, uint16_t expected,
+                       size_t len, unsigned int seed, unsigned int offset) {
+    if (actual != expected) {
+        fprintf(stderr, "%s: len=%zu seed=%04x offset=%u actual=%04x expected=%04x\n",
+                path, len, seed, offset, actual, expected);
+        exit(1);
+    }
+}
+
+#ifdef CRC16_USE_OPTIMIZED
+extern uint16_t crc16_xmodem_short(uint16_t, const uint8_t *, uint64_t);
+extern uint16_t crc16_xmodem_pmull(uint16_t, const uint8_t *, uint64_t);
+extern uint16_t crc16_xmodem_pmull_8way_neon(uint16_t, const uint8_t *, uint64_t);
+#ifdef REDIS_CRC16_SVE
+extern uint16_t crc16_xmodem_pmull_8way(uint16_t, const uint8_t *, uint64_t);
+#endif
+#endif
+
+static void crc16CheckPaths(const uint8_t *buf, size_t len, uint16_t seed,
+                            uint16_t expected, unsigned int offset) {
+    crc16Check("scalar", crc16_xmodem_scalar(seed, buf, len), expected, len, seed, offset);
+    if (seed == 0)
+        crc16Check("public", crc16((const char *)buf, (int)len), expected, len, seed, offset);
+#ifdef CRC16_USE_OPTIMIZED
+    /* 硬件能力不足时不直接调用包含可选指令的入口。 */
+    if (crc16_has_optimized) {
+        crc16Check("dispatch", crc16_xmodem(seed, buf, len), expected, len, seed, offset);
+        if (len >= 16)
+            crc16Check("short", crc16_xmodem_short(seed, buf, len), expected, len, seed, offset);
+        crc16Check("pmull", crc16_xmodem_pmull(seed, buf, len), expected, len, seed, offset);
+        crc16Check("neon", crc16_xmodem_pmull_8way_neon(seed, buf, len), expected, len, seed, offset);
+#ifdef REDIS_CRC16_SVE
+        if (crc16_use_sve_wide)
+            crc16Check("sve", crc16_xmodem_pmull_8way(seed, buf, len), expected, len, seed, offset);
+#endif
+    }
+#endif
+}
+
+static void crc16CheckBuffer(const uint8_t *buf, size_t len, unsigned int offset) {
+    static const uint16_t seeds[] = {0, 1, 0x1021, 0x8000, 0xffff};
+    for (size_t i = 0; i < sizeof(seeds) / sizeof(seeds[0]); i++) {
+        uint16_t expected = crc16Reference(seeds[i], buf, len);
+        crc16CheckPaths(buf, len, seeds[i], expected, offset);
+    }
+}
+
+int main(void) {
+    static const size_t large_lengths[] = {4097, 8191, 8192, 8193, 16383,
+                                           16384, 16385, 32767, 32768, 32769};
+    uint8_t buf[32769 + 16];
+    uint32_t random = 0x12345678;
+    for (size_t i = 0; i < sizeof(buf); i++) {
+        random ^= random << 13;
+        random ^= random >> 17;
+        random ^= random << 5;
+        buf[i] = (uint8_t)random;
+    }
+    crc16Check("XMODEM vector", crc16("123456789", 9), 0x31c3, 9, 0, 0);
+    crc16Check("negative length", crc16(NULL, -1), 0, 0, 0, 0);
+    for (unsigned int offset = 0; offset < 16; offset++) {
+        /* 逐步扩展参考值，覆盖每个长度而不重复执行整段逐位运算。 */
+        static const uint16_t seeds[] = {0, 1, 0x1021, 0x8000, 0xffff};
+        for (size_t s = 0; s < sizeof(seeds) / sizeof(seeds[0]); s++) {
+            uint16_t expected = seeds[s];
+            for (size_t len = 0; len <= 4096; len++) {
+                crc16CheckPaths(buf + offset, len, seeds[s], expected, offset);
+                expected = crc16Reference(expected, buf + offset + len, 1);
+            }
+        }
+        for (size_t i = 0; i < sizeof(large_lengths) / sizeof(large_lengths[0]); i++)
+            crc16CheckBuffer(buf + offset, large_lengths[i], offset);
+    }
+    memset(buf, 0, sizeof(buf));
+    crc16CheckBuffer(buf, 32769, 0);
+    memset(buf, 0xff, sizeof(buf));
+    crc16CheckBuffer(buf, 32769, 0);
+#ifdef __linux__
+    /* 两端保护页分别捕获越界前读和越界后读，包括零长度输入。 */
+    long page = sysconf(_SC_PAGESIZE);
+    if (page <= 0) return 1;
+    size_t span = ((32769 + (size_t)page - 1) / (size_t)page) * (size_t)page;
+    uint8_t *mapping = mmap(NULL, span + 2 * (size_t)page, PROT_NONE,
+                            MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (mapping == MAP_FAILED) { perror("mmap"); return 1; }
+    uint8_t *data = mapping + page;
+    if (mprotect(data, span, PROT_READ | PROT_WRITE)) { perror("mprotect"); return 1; }
+    memset(data, 0xa5, span);
+    for (size_t len = 0; len <= 4096; len++) {
+        crc16CheckBuffer(data, len, 0);
+        crc16CheckBuffer(data + span - len, len, 0);
+    }
+    for (size_t i = 0; i < sizeof(large_lengths) / sizeof(large_lengths[0]); i++) {
+        size_t len = large_lengths[i];
+        crc16CheckBuffer(data, len, 0);
+        crc16CheckBuffer(data + span - len, len, 0);
+    }
+    munmap(mapping, span + 2 * (size_t)page);
+#endif
+#ifdef CRC16_USE_OPTIMIZED
+    if (!crc16_has_optimized)
+        puts("SKIP: assembly paths (required CPU features unavailable)");
+#ifdef REDIS_CRC16_SVE
+    if (!crc16_use_sve_wide)
+        puts("SKIP: SVE path (required CPU features unavailable)");
+#endif
+#else
+    puts("SKIP: assembly paths (not built on this target)");
+#endif
+    puts("CRC16 correctness tests passed");
+    return 0;
+}
+#endif
diff --git a/src/crc16_xmodem_dispatch.c b/src/crc16_xmodem_dispatch.c
new file mode 100644
index 0000000..b056e21
--- /dev/null
+++ b/src/crc16_xmodem_dispatch.c
@@ -0,0 +1,37 @@
+/**
+ * General-length CRC16/XMODEM selection behind the assembly public entry.
+ * Public entry preserves exact 16B/64B fast paths; 8..15B seed=0 uses a
+ * bounded-load polynomial path. Other inputs arrive here:
+ * <16B scalar, 16..127B short, 128..4095B 4-way, >=4096B wide.
+ * The short API delegates >=128B back to this selector, without recursion.
+ */
+
+#include <stdint.h>
+
+extern uint16_t crc16_xmodem_scalar(uint16_t seed, const uint8_t *buf, uint64_t len);
+extern uint16_t crc16_xmodem_pmull(uint16_t seed, const uint8_t *buf, uint64_t len);
+extern uint16_t crc16_xmodem_short(uint16_t seed, const uint8_t *buf, uint64_t len);
+extern uint16_t crc16_xmodem_pmull_8way(uint16_t seed, const uint8_t *buf, uint64_t len);
+extern uint16_t crc16_xmodem_pmull_8way_neon(uint16_t seed, const uint8_t *buf, uint64_t len);
+#ifdef REDIS_CRC16_SVE
+extern int crc16_use_sve_wide;
+#endif
+
+uint16_t crc16_xmodem_generic(uint16_t seed, const uint8_t *buf, uint64_t len)
+{
+    if (len >= 128) {
+        if (len >= 4096) {
+#ifdef REDIS_CRC16_SVE
+            /* The SVE kernel requires SVE2 + SVEPMULL and 256-bit VL.
+             * Other vector lengths fall back inside the assembly entry. */
+            if (len >= 16384 && crc16_use_sve_wide)
+                return crc16_xmodem_pmull_8way(seed, buf, len);
+#endif
+            return crc16_xmodem_pmull_8way_neon(seed, buf, len);
+        }
+        return crc16_xmodem_pmull(seed, buf, len);
+    }
+    if (len >= 16)
+        return crc16_xmodem_short(seed, buf, len);
+    return crc16_xmodem_scalar(seed, buf, len);
+}
diff --git a/src/crc16_xmodem_pmull.S b/src/crc16_xmodem_pmull.S
new file mode 100644
index 0000000..11baa69
--- /dev/null
+++ b/src/crc16_xmodem_pmull.S
@@ -0,0 +1,140 @@
+/* General CRC16/XMODEM folding kernel. Arbitrary seed and byte length.
+ * Caller-saved SIMD registers only. Safe exact in-buffer loads.
+ * Reciprocal reduction and balanced polynomial merges. */
+#ifdef CRC16_USE_SHA3
+ .arch armv8.2-a+crc+crypto+sha3
+#else
+ .arch armv8-a+crc+crypto
+#endif
+ .text
+ .p2align 4
+ .global crc16_xmodem_pmull
+ .type crc16_xmodem_pmull, %function
+crc16_xmodem_pmull:
+ cmp x2, #128
+ b.lo crc16_xmodem
+.Lmain:
+ and x3, x2, #-64
+ sub x3, x3, #64
+ ldr q7, .Lmask
+ ld1 {v2.16b-v5.16b}, [x1], #64
+ tbl v2.16b, {v2.16b}, v7.16b
+ tbl v3.16b, {v3.16b}, v7.16b
+ tbl v4.16b, {v4.16b}, v7.16b
+ tbl v5.16b, {v5.16b}, v7.16b
+ cbz w0, .Lmain_seed_ready
+ lsl x0, x0, #48
+ fmov d16, xzr
+ ins v16.d[1], x0
+ eor v2.16b, v2.16b, v16.16b
+.Lmain_seed_ready:
+ cbz x3, .Lmain_post
+ ldr q17, .Lstride4
+ .p2align 4
+.Lmain_loop:
+ ld1 {v28.16b-v31.16b}, [x1], #64
+ prfm pldl2strm, [x1,#1024]
+ tbl v28.16b, {v28.16b}, v7.16b
+ tbl v29.16b, {v29.16b}, v7.16b
+ tbl v30.16b, {v30.16b}, v7.16b
+ tbl v31.16b, {v31.16b}, v7.16b
+ pmull2 v24.1q, v2.2d, v17.2d
+ pmull v2.1q, v2.1d, v17.1d
+#ifdef CRC16_USE_SHA3
+ eor3 v2.16b, v2.16b, v24.16b, v28.16b
+#else
+ eor v2.16b, v2.16b, v24.16b
+ eor v2.16b, v2.16b, v28.16b
+#endif
+ pmull2 v24.1q, v3.2d, v17.2d
+ pmull v3.1q, v3.1d, v17.1d
+#ifdef CRC16_USE_SHA3
+ eor3 v3.16b, v3.16b, v24.16b, v29.16b
+#else
+ eor v3.16b, v3.16b, v24.16b
+ eor v3.16b, v3.16b, v29.16b
+#endif
+ pmull2 v24.1q, v4.2d, v17.2d
+ pmull v4.1q, v4.1d, v17.1d
+#ifdef CRC16_USE_SHA3
+ eor3 v4.16b, v4.16b, v24.16b, v30.16b
+#else
+ eor v4.16b, v4.16b, v24.16b
+ eor v4.16b, v4.16b, v30.16b
+#endif
+ pmull2 v24.1q, v5.2d, v17.2d
+ pmull v5.1q, v5.1d, v17.1d
+#ifdef CRC16_USE_SHA3
+ eor3 v5.16b, v5.16b, v24.16b, v31.16b
+#else
+ eor v5.16b, v5.16b, v24.16b
+ eor v5.16b, v5.16b, v31.16b
+#endif
+ subs x3, x3, #64
+ b.ne .Lmain_loop
+.Lmain_post:
+ and x2, x2, #63
+ adr x6, .Ltree
+ ldp q16, q17, [x6]
+ pmull2 v6.1q, v2.2d, v17.2d
+ pmull2 v18.1q, v3.2d, v17.2d
+ pmull v2.1q, v2.1d, v17.1d
+ pmull v3.1q, v3.1d, v17.1d
+#ifdef CRC16_USE_SHA3
+ eor3 v4.16b, v2.16b, v6.16b, v4.16b
+#else
+ eor v4.16b, v4.16b, v2.16b
+ eor v4.16b, v4.16b, v6.16b
+#endif
+#ifdef CRC16_USE_SHA3
+ eor3 v5.16b, v3.16b, v18.16b, v5.16b
+#else
+ eor v5.16b, v5.16b, v3.16b
+ eor v5.16b, v5.16b, v18.16b
+#endif
+ pmull2 v6.1q, v4.2d, v16.2d
+ pmull v4.1q, v4.1d, v16.1d
+#ifdef CRC16_USE_SHA3
+ eor3 v5.16b, v4.16b, v6.16b, v5.16b
+#else
+ eor v5.16b, v5.16b, v4.16b
+ eor v5.16b, v5.16b, v6.16b
+#endif
+ mov v2.16b, v5.16b
+ b .Lreduce
+.Lreduce:
+ adr x6, .Lreciprocal
+ ldp q16, q17, [x6]
+ pmull2 v0.1q, v2.2d, v16.2d
+ pmull v1.1q, v2.1d, v16.1d
+ pmull2 v3.1q, v2.2d, v17.2d
+ eor v1.16b, v1.16b, v3.16b
+ ext v1.16b, v1.16b, v1.16b, #8
+#ifdef CRC16_USE_SHA3
+ eor3 v1.16b, v1.16b, v0.16b, v2.16b
+#else
+ eor v1.16b, v1.16b, v0.16b
+ eor v1.16b, v1.16b, v2.16b
+#endif
+ umov w4, v1.h[0]
+ eor w0, w4, w4, lsl #5
+ eor w0, w0, w4, lsl #12
+ uxth w0, w0
+ cbnz x2, crc16_xmodem
+ ret
+ .size crc16_xmodem_pmull, .-crc16_xmodem_pmull
