+
+	/* Remaining 16B blocks: fold state by x^128, XOR in new data */
+	.align 2
+.crc_short_loop:
+	cmp	x2, #16
+	b.lo	.crc_short_partial
+	ld1	{v28.16b}, [x1], #16
+	sub	x2, x2, #16
+	tbl	v28.16b, {v28.16b}, v7.16b
+	pmull2	v24.1q, v2.2d, v17.2d
+	pmull	v2.1q,  v2.1d, v17.1d
